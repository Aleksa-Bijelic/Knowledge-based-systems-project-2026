package rules;

dialect "mvel";

import com.example.bookstore.model.Book;
import com.example.bookstore.model.Order;
import com.example.bookstore.model.Rating;
import com.example.bookstore.rules.AuthorStats;
import com.example.bookstore.rules.BookRatingCount;
import com.example.bookstore.rules.BookScore;
import com.example.bookstore.rules.BookPairSimilarity;
import com.example.bookstore.rules.ExistingUserBookScore;
import com.example.bookstore.rules.GenreMatch;
import com.example.bookstore.rules.QualifiedAuthor;
import com.example.bookstore.rules.RecommendationDataPreparer;
import com.example.bookstore.rules.SimilarUser;
import com.example.bookstore.rules.UserPreferredAuthor;
import com.example.bookstore.rules.UserPreferredGenre;
import com.example.bookstore.rules.UserRecommendationFact;
import com.example.bookstore.rules.LikedBookByUser;

import java.util.List;

// =====================================================================
// NEW USER RULES (user with fewer than 10 ratings)
// =====================================================================

rule "Count ratings per book for new user" salience 50 no-loop true
when
    $userFact : UserRecommendationFact(newUser == true, genreSelectionMade == true)
    $book : Book($bookId : id)
    not BookRatingCount(bookId == $bookId)
    $count : Number() from accumulate(
        Rating(book.id == $bookId),
        count(1)
    )
then
    insert(new BookRatingCount($bookId, $count.longValue()));
end

rule "Calculate author statistics for new user" salience 40 no-loop true
when
    $userFact : UserRecommendationFact(newUser == true, genreSelectionMade == true)
    $book : Book($author : author)
    not AuthorStats(author == $author)
    $totalBooks : Number(intValue >= 1) from accumulate(
        Book(author == $author),
        count(1)
    )
    $totalRatings : Number() from accumulate(
        Book(author == $author, $id : id) and BookRatingCount(bookId == $id, $rc : count),
        sum($rc)
    )
then
    insert(new AuthorStats($author, $totalBooks.longValue(), $totalRatings.longValue()));
end

rule "Compute author genre membership" salience 40 no-loop true
when
    $userFact : UserRecommendationFact(newUser == true, genreSelectionMade == true, $genres : favoriteGenres)
    $genre : String() from $genres
    $book : Book($author : author)
    not GenreMatch(author == $author, genre == $genre)
    $inGenre : Number(intValue > 0) from accumulate(
        Book(author == $author, genre == $genre),
        count(1)
    )
    $total : Number(intValue > 0) from accumulate(
        Book(author == $author),
        count(1)
    )
    eval($inGenre.doubleValue() / $total.doubleValue() >= 0.3)
then
    insert(new GenreMatch($author, $genre));
end

rule "Identify qualified authors" salience 30 no-loop true
when
    $userFact : UserRecommendationFact(newUser == true, genreSelectionMade == true, $genres : favoriteGenres)
    $genre : String() from $genres
    $matchedAuthor : GenreMatch(genre == $genre)
    $authorStats : AuthorStats(author == $matchedAuthor.author, totalRatingCount > 0)
    not QualifiedAuthor(author == $matchedAuthor.author)
then
    insert(new QualifiedAuthor($matchedAuthor.author, $authorStats.getTotalRatingCount(), true));
end

rule "Calculate book scores for qualified authors" salience 10 no-loop true
when
    $qa : QualifiedAuthor(selected == true, $author : author)
    $book : Book(author == $author, $bookId : id)
    not BookScore(bookId == $bookId)
    $ratingCount : Number(intValue > 0) from accumulate(
        Rating(book.id == $bookId, $score : score),
        count(1)
    )
    $avgScore : Number() from accumulate(
        Rating(book.id == $bookId, $score : score),
        average($score)
    )
then
    insert(new BookScore($bookId, $avgScore.doubleValue()));
end

// =====================================================================
// EXISTING USER RULES (user with 10 or more ratings)
// =====================================================================

rule "Prepare existing user recommendation data" salience 100 no-loop true
when
    $userFact : UserRecommendationFact(newUser == false, $username : username)
    $allRatings : List() from collect(Rating())
    $allOrders : List() from collect(Order())
    $allBooks : List() from collect(Book())
then
    RecommendationDataPreparer.prepareForExistingUser(
        kcontext.getKieRuntime(),
        (String) $username,
        (List) $allRatings,
        (List) $allOrders,
        (List) $allBooks
    );
end

rule "Existing user - criterion 1 - similar users liked this book" no-loop true
when
    $userFact : UserRecommendationFact(newUser == false, $username : username)
    $book : Book($bookId : id)
    $score : ExistingUserBookScore(bookId == $bookId, criterion1Met == false)
    exists (SimilarUser(username == $username, $similarUsername : similarUsername) and
            LikedBookByUser(username == $similarUsername, bookId == $bookId))
then
    modify($score) {
        setScore($score.getScore() + 1),
        setCriterion1Met(true)
    }
end

rule "Existing user - criterion 2a - book similar to liked book (bookId1 == likedBookId)" no-loop true
when
    $userFact : UserRecommendationFact(newUser == false, $username : username)
    $book : Book($bookId : id)
    $score : ExistingUserBookScore(bookId == $bookId, criterion2Met == false)
    exists (LikedBookByUser(username == $username, $likedBookId : bookId) and
            BookPairSimilarity(bookId1 == $likedBookId, bookId2 == $bookId))
then
    modify($score) {
        setScore($score.getScore() + 1),
        setCriterion2Met(true)
    }
end

rule "Existing user - criterion 2b - book similar to liked book (bookId2 == likedBookId)" no-loop true
when
    $userFact : UserRecommendationFact(newUser == false, $username : username)
    $book : Book($bookId : id)
    $score : ExistingUserBookScore(bookId == $bookId, criterion2Met == false)
    exists (LikedBookByUser(username == $username, $likedBookId : bookId) and
            BookPairSimilarity(bookId1 == $bookId, bookId2 == $likedBookId))
then
    modify($score) {
        setScore($score.getScore() + 1),
        setCriterion2Met(true)
    }
end

rule "Existing user - criterion 3 - matches user preferences" no-loop true
when
    $userFact : UserRecommendationFact(newUser == false, $username : username)
    $book : Book($bookId : id, $author : author, $genre : genre)
    $score : ExistingUserBookScore(bookId == $bookId, criterion3Met == false)
    (exists UserPreferredAuthor(username == $username, author == $author) or
     exists UserPreferredGenre(username == $username, genre == $genre))
then
    modify($score) {
        setScore($score.getScore() + 1),
        setCriterion3Met(true)
    }
end
