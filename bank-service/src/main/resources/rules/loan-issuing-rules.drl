package rules;

import com.example.bank.rules.LoanRequestFact;
import com.example.bank.rules.ClientFinancialProfile;
import com.example.bank.rules.LoanAssessment;
import com.example.bank.rules.LoanFact;
import com.example.bank.rules.LoanRepaymentFact;
import com.example.bank.rules.RiskFactorFact;
import com.example.bank.rules.PositiveCreditHistoryFact;
import com.example.bank.rules.DecisionReasonFact;
import com.example.bank.rules.DebtToIncomeFact;
import com.example.bank.rules.RiskThresholdFact;
import java.time.LocalDate;
import java.time.Period;

function double computeMonthlyPayment(double amount, int installments) {
    double annualRate = 0.05;
    if (installments <= 0) return 0.0;
    double monthlyRate = annualRate / 12.0;
    if (monthlyRate > 0) {
        double factor = Math.pow(1 + monthlyRate, installments);
        double payment = (amount * monthlyRate * factor) / (factor - 1);
        return Math.round(payment * 100.0) / 100.0;
    }
    return Math.round((amount / installments) * 100.0) / 100.0;
}

// ========================================================================
// BACKWARD CHAINING QUERY HIERARCHY
// ========================================================================

query isLoanApproved(Long $clientId)
    hasValidLoanPeriod($clientId; ) and
    hasStableEmployment($clientId; ) and
    hasSufficientIncome($clientId; ) and
    hasAcceptableRisk($clientId; ) and
    hasGoodCreditHistory($clientId; ) and
    hasNoDefaultedLoans($clientId; ) and
    hasNoSeriousDelinquencies($clientId; ) and
    agePlusLoanTermWithinLimit($clientId; )
end

query hasValidLoanPeriod(Long $clientId)
    meetsMinimumPeriod($clientId; ) and
    withinMaximumPeriod($clientId; )
end

query meetsMinimumPeriod(Long $clientId)
    LoanRequestFact(clientId == $clientId, numberOfInstallments >= 3)
end

query withinMaximumPeriod(Long $clientId)
    LoanRequestFact(clientId == $clientId, numberOfInstallments <= 360)
end

query hasStableEmployment(Long $clientId)
    isNotUnemployed($clientId; ) and
    hasValidContractStartDate($clientId; ) and
    hasSufficientEmploymentTenure($clientId; ) and
    employmentCoversSufficientTerm($clientId; )
end

query isNotUnemployed(Long $clientId)
    LoanRequestFact(clientId == $clientId, employmentStatus != null, employmentStatus != "UNEMPLOYED")
end

query hasValidContractStartDate(Long $clientId)
    $req: LoanRequestFact(clientId == $clientId, employmentStatus == "UNEMPLOYED")
    or
    $req: LoanRequestFact(clientId == $clientId, employmentStatus != "UNEMPLOYED", contractStartDate != null)
end

query hasSufficientEmploymentTenure(Long $clientId)
    $req: LoanRequestFact(clientId == $clientId, employmentStatus == "UNEMPLOYED")
    or
    $req: LoanRequestFact(clientId == $clientId, employmentStatus != "UNEMPLOYED", contractStartDate != null)
    eval(!$req.getEmploymentStatus().equals("UNEMPLOYED") &&
         Period.between($req.getContractStartDate(), LocalDate.now()).toTotalMonths() >= 6)
end

query employmentCoversSufficientTerm(Long $clientId)
    indefiniteEmployment($clientId; )
    or
    fixedTermEmploymentCoversSufficientPortion($clientId; )
end

query indefiniteEmployment(Long $clientId)
    LoanRequestFact(clientId == $clientId, employmentStatus != null, employmentStatus != "FIXED_TERM")
end

query fixedTermEmploymentCoversSufficientPortion(Long $clientId)
    $req: LoanRequestFact(clientId == $clientId, employmentStatus != null, contractEndDate != null)
    eval($req.getEmploymentStatus().equals("FIXED_TERM") &&
         ($req.getContractEndDate().isAfter(LocalDate.now().plusMonths(($req.getNumberOfInstallments() + 1) / 2)) ||
          !$req.getContractEndDate().isBefore(LocalDate.now().plusMonths(24))))
end

query hasSufficientIncome(Long $clientId)
    hasAffordableDebtToIncome($clientId; )
end

query hasAffordableDebtToIncome(Long $clientId)
    DebtToIncomeFact(clientId == $clientId, value <= 0.4)
end

query hasAcceptableRisk(Long $clientId)
    loanRiskScoreWithinLimit($clientId; ) and
    notExcessiveExistingLoans($clientId; )
end

query loanRiskScoreWithinLimit(Long $clientId)
    $assessment: LoanAssessment(clientId == $clientId, $score: riskScore)
    $threshold: RiskThresholdFact($t: threshold)
    eval($score < $t)
end

query notExcessiveExistingLoans(Long $clientId)
    not hasThreeOrMoreActiveLoans($clientId; )
end

query hasThreeOrMoreActiveLoans(Long $clientId)
    $loan1: LoanFact(clientId == $clientId, status == "ACTIVE")
    $loan2: LoanFact(clientId == $clientId, status == "ACTIVE", this != $loan1)
    $loan3: LoanFact(clientId == $clientId, status == "ACTIVE", this != $loan1, this != $loan2)
end

query hasGoodCreditHistory(Long $clientId)
    not hasBadCreditHistory($clientId; )
end

query hasBadCreditHistory(Long $clientId)
    hasPreviousLoans($clientId; ) and
    (hasAnyDefaultedLoan($clientId; ) or hasAnyDelinquentRepayment($clientId; ))
end

query hasPreviousLoans(Long $clientId)
    LoanFact(clientId == $clientId)
end

query hasNoDefaultedLoans(Long $clientId)
    not hasAnyDefaultedLoan($clientId; )
end

query hasAnyDefaultedLoan(Long $clientId)
    LoanFact(clientId == $clientId, status == "DEFAULTED")
end

query hasNoSeriousDelinquencies(Long $clientId)
    not hasAnyDelinquentRepayment($clientId; )
end

query hasAnyDelinquentRepayment(Long $clientId)
    $loan: LoanFact(clientId == $clientId, $loanId: loanId)
    $rp: LoanRepaymentFact(loanId == $loanId, status == "LATE" || status == "MISSED")
end

query agePlusLoanTermWithinLimit(Long $clientId)
    $profile: ClientFinancialProfile(clientId == $clientId, $age: age)
    $req: LoanRequestFact(clientId == $clientId, numberOfInstallments > 0)
    eval($age * 12 + $req.getNumberOfInstallments() <= 75 * 12)
end

// ========================================================================
// RULES
// ========================================================================

rule "Initialize Loan Assessment"
    salience 100
    when
        $req: LoanRequestFact($clientId: clientId, $amount: loanAmount, $inst: numberOfInstallments)
        $profile: ClientFinancialProfile(clientId == $clientId)
        not LoanAssessment(clientId == $clientId)
    then
        LoanAssessment assessment = new LoanAssessment($clientId);
        double payment = computeMonthlyPayment($amount, $inst);
        double dti = $profile.getMonthlyIncome() > 0
            ? (payment + $profile.getTotalExistingLoanPayments()) / $profile.getMonthlyIncome()
            : 1.0;
        assessment.setMonthlyPayment(payment);
        assessment.setDebtToIncomeRatio(Math.round(dti * 10000.0) / 10000.0);
        insert(assessment);
        insert(new DebtToIncomeFact($clientId, dti));
end

rule "Initialize Risk Threshold"
    salience 100
    when
        not RiskThresholdFact()
    then
        insert(new RiskThresholdFact(50.0));
end

// ========================================================================
// RISK FACTOR RULES — individual risk factor contributions
// Replaces the old centralized computeRiskScore() function
// ========================================================================

rule "Risk Factor - Age over 60 and installments over 120"
    salience 50
    when
        $req: LoanRequestFact($clientId: clientId, numberOfInstallments > 120)
        $profile: ClientFinancialProfile(clientId == $clientId, age > 60)
    then
        insert(new RiskFactorFact($clientId, 30.0, "Age over 60 and loan term over 120 months"));
end

rule "Risk Factor - Age over 55 and installments over 180"
    salience 50
    when
        $req: LoanRequestFact($clientId: clientId, numberOfInstallments > 180)
        $profile: ClientFinancialProfile(clientId == $clientId, age > 55)
    then
        insert(new RiskFactorFact($clientId, 15.0, "Age over 55 and loan term over 180 months"));
end

rule "Risk Factor - Low account balance"
    salience 50
    when
        $req: LoanRequestFact($clientId: clientId, $amount: loanAmount)
        $profile: ClientFinancialProfile(clientId == $clientId, accountBalance < $amount * 0.1)
    then
        insert(new RiskFactorFact($clientId, 5.0, "Low account balance relative to loan amount"));
end

rule "Risk Factor - One or two active loans"
    salience 50
    when
        $req: LoanRequestFact($clientId: clientId)
        exists LoanFact(clientId == $clientId, status == "ACTIVE")
        not hasThreeOrMoreActiveLoans($clientId; )
        not RiskFactorFact(clientId == $clientId, points == 10.0)
    then
        insert(new RiskFactorFact($clientId, 10.0, "One or two active loans"));
end

rule "Risk Factor - Three or more active loans"
    salience 50
    when
        $req: LoanRequestFact($clientId: clientId)
        hasThreeOrMoreActiveLoans($clientId; )
        not RiskFactorFact(clientId == $clientId, points == 20.0)
    then
        insert(new RiskFactorFact($clientId, 20.0, "Three or more active loans"));
end

rule "Risk Factor - Fixed term employment"
    salience 50
    when
        $req: LoanRequestFact($clientId: clientId, employmentStatus == "FIXED_TERM")
    then
        insert(new RiskFactorFact($clientId, 10.0, "Fixed term employment"));
end

rule "Risk Factor - Indefinite and young reduction"
    salience 50
    when
        $req: LoanRequestFact($clientId: clientId, employmentStatus == "INDEFINITE")
        $profile: ClientFinancialProfile(clientId == $clientId, age < 55)
    then
        insert(new RiskFactorFact($clientId, -10.0, "Indefinite employment and age under 55"));
end

rule "Risk Factor - Loan less than annual income"
    salience 50
    when
        $req: LoanRequestFact($clientId: clientId, $amount: loanAmount)
        $profile: ClientFinancialProfile(clientId == $clientId, monthlyIncome > 0)
        eval($amount <= $profile.getMonthlyIncome() * 12.0)
    then
        insert(new RiskFactorFact($clientId, -5.0, "Loan amount within annual income"));
end

// ========================================================================
// POSITIVE CREDIT HISTORY — reward clients with clean repayment record
// ========================================================================

rule "Positive Credit History - Risk Reduction"
    salience 50
    when
        $req: LoanRequestFact($clientId: clientId)
        hasPreviousLoans($clientId; )
        not hasAnyDefaultedLoan($clientId; )
        not hasAnyDelinquentRepayment($clientId; )
        exists (LoanFact(clientId == $clientId, $loanId: loanId) and LoanRepaymentFact(loanId == $loanId))
        not PositiveCreditHistoryFact(clientId == $clientId)
    then
        insert(new RiskFactorFact($clientId, -15.0, "Positive credit history - good repayment track record"));
        insert(new PositiveCreditHistoryFact($clientId));
end

// ========================================================================
// SUMMATION — sum all RiskFactorFact objects into final risk score
// ========================================================================

rule "Sum Risk Factor Scores"
    salience 40
    when
        $req: LoanRequestFact($clientId: clientId)
        $assessment: LoanAssessment(clientId == $clientId)
        $total: Number() from accumulate(
            RiskFactorFact(clientId == $clientId, $points: points),
            sum($points)
        )
    then
        double score = Math.max(0.0, $total.doubleValue());
        $assessment.setRiskScore(score);
        update($assessment);
end

// ========================================================================
// RISK LEVEL RULES — replace computeRiskLevel() function
//
// Safety: riskLevel == null ensures each assessment gets classified exactly
// once. The Summation rule (salience 40) always fires before these rules
// (salience 30), so riskScore is final when riskLevel is assigned.
// No rule modifies riskScore after the summation, so no staleness risk.
// ========================================================================

rule "Risk Level LOW"
    salience 30
    when
        $assessment: LoanAssessment(riskScore < 15.0, riskLevel == null)
    then
        $assessment.setRiskLevel("LOW");
        update($assessment);
end

rule "Risk Level MEDIUM"
    salience 30
    when
        $assessment: LoanAssessment(riskScore >= 15.0, riskScore < 35.0, riskLevel == null)
    then
        $assessment.setRiskLevel("MEDIUM");
        update($assessment);
end

rule "Risk Level HIGH"
    salience 30
    when
        $assessment: LoanAssessment(riskScore >= 35.0, riskScore < 50.0, riskLevel == null)
    then
        $assessment.setRiskLevel("HIGH");
        update($assessment);
end

rule "Risk Level VERY_HIGH"
    salience 30
    when
        $assessment: LoanAssessment(riskScore >= 50.0, riskLevel == null)
    then
        $assessment.setRiskLevel("VERY_HIGH");
        update($assessment);
end

// ========================================================================
// DECISION REASON RULES — explain each finding
// ========================================================================

rule "Decision Reason - Unemployed"
    salience 20
    when
        $req: LoanRequestFact($clientId: clientId, employmentStatus == "UNEMPLOYED")
    then
        insert(new DecisionReasonFact($clientId, "Client is unemployed"));
end

rule "Decision Reason - DTI too high"
    salience 20
    when
        DebtToIncomeFact($clientId: clientId, value > 0.4)
    then
        insert(new DecisionReasonFact($clientId, "Debt-to-income ratio exceeds 0.4 threshold"));
end

rule "Decision Reason - Defaulted loan exists"
    salience 20
    when
        $req: LoanRequestFact($clientId: clientId)
        hasAnyDefaultedLoan($clientId; )
        not DecisionReasonFact(clientId == $clientId, reason == "Client has a loan in DEFAULTED status")
    then
        insert(new DecisionReasonFact($clientId, "Client has a loan in DEFAULTED status"));
end

rule "Decision Reason - Excessive active loans"
    salience 20
    when
        $req: LoanRequestFact($clientId: clientId)
        hasThreeOrMoreActiveLoans($clientId; )
        not DecisionReasonFact(clientId == $clientId, reason == "Client has 3 or more active loans")
    then
        insert(new DecisionReasonFact($clientId, "Client has 3 or more active loans"));
end

rule "Decision Reason - Delinquent repayments"
    salience 20
    when
        $req: LoanRequestFact($clientId: clientId)
        hasAnyDelinquentRepayment($clientId; )
        not DecisionReasonFact(clientId == $clientId, reason == "Client has late or missed repayments")
    then
        insert(new DecisionReasonFact($clientId, "Client has late or missed repayments"));
end

rule "Decision Reason - Age plus loan term exceeds limit"
    salience 20
    when
        $profile: ClientFinancialProfile($clientId: clientId, $age: age)
        $req: LoanRequestFact(clientId == $clientId, numberOfInstallments > 0)
        eval($age * 12 + $req.getNumberOfInstallments() > 75 * 12)
    then
        insert(new DecisionReasonFact($clientId, "Client age plus loan term exceeds 75 year limit"));
end

rule "Decision Reason - Fixed term insufficient coverage"
    salience 20
    when
        $req: LoanRequestFact($clientId: clientId, employmentStatus == "FIXED_TERM", contractEndDate != null, $inst: numberOfInstallments)
        eval($req.getContractEndDate().isBefore(LocalDate.now().plusMonths(($inst + 1) / 2)) &&
             $req.getContractEndDate().isBefore(LocalDate.now().plusMonths(24)))
    then
        insert(new DecisionReasonFact($clientId, "Fixed term contract does not cover sufficient loan period"));
end

rule "Decision Reason - Insufficient employment tenure"
    salience 20
    when
        $req: LoanRequestFact($clientId: clientId, employmentStatus != "UNEMPLOYED", contractStartDate != null)
        eval(Period.between($req.getContractStartDate(), LocalDate.now()).toTotalMonths() < 6)
    then
        insert(new DecisionReasonFact($clientId, "Employment tenure is less than 6 months"));
end

rule "Decision Reason - Good credit history"
    salience 20
    when
        PositiveCreditHistoryFact($clientId: clientId)
        not DecisionReasonFact(clientId == $clientId, reason == "Good credit history - positive repayment track record")
    then
        insert(new DecisionReasonFact($clientId, "Good credit history - positive repayment track record"));
end

rule "Decision Reason - High risk score"
    salience 20
    when
        $assessment: LoanAssessment($clientId: clientId, riskScore >= 50.0)
    then
        insert(new DecisionReasonFact($clientId, "Overall risk score is too high for loan approval"));
end
