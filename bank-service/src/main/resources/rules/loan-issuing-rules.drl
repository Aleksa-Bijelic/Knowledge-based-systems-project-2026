package rules;

dialect "mvel";

import com.example.bank.rules.LoanRequest;
import com.example.bank.rules.ClientFinancialProfile;
import com.example.bank.rules.LoanAssessment;
import java.time.LocalDate;

function double computeMonthlyPayment(double amount, int installments) {
    double monthlyRate = 0.05 / 12.0;
    if (installments > 0 && monthlyRate > 0) {
        double payment = (amount * monthlyRate * Math.pow(1 + monthlyRate, installments)) /
                         (Math.pow(1 + monthlyRate, installments) - 1);
        return Math.round(payment * 100.0) / 100.0;
    }
    return installments > 0 ? Math.round((amount / installments) * 100.0) / 100.0 : 0.0;
}

function double computeRiskScore(LoanRequest req, ClientFinancialProfile profile) {
    double score = 0.0;
    if (profile.getAge() > 60 && req.getNumberOfInstallments() > 120) {
        score += 30.0;
    }
    if (profile.getExistingLoanCount() >= 3) {
        score += 20.0;
    }
    if (profile.isHasGoodRepaymentHistory()) {
        score = Math.max(0.0, score - 15.0);
    }
    if (req.getEmploymentStatus() != null
        && req.getEmploymentStatus().toUpperCase().equals("INDEFINITE")
        && profile.getAge() < 55) {
        score = Math.max(0.0, score - 10.0);
    }
    return score;
}

function String computeRiskLevel(double score) {
    if (score < 20.0) return "LOW";
    if (score < 50.0) return "MEDIUM";
    return "HIGH";
}

// ========================================================================
// BACKWARD CHAINING QUERY HIERARCHY (4 levels deep)
// ========================================================================

// Level 1: Top-level goal — is this loan approvable?
query isLoanApproved(Long $clientId)
    hasValidLoanPeriod($clientId; ) and
    hasStableEmployment($clientId; ) and
    hasSufficientIncome($clientId; ) and
    hasAcceptableRisk($clientId; )
end

// ========================================================================
// Level 2: Loan period validation
// ========================================================================
query hasValidLoanPeriod(Long $clientId)
    meetsMinimumPeriod($clientId; ) and
    withinMaximumPeriod($clientId; )
end

// Level 3: Minimum period check
query meetsMinimumPeriod(Long $clientId)
    LoanRequest(clientId == $clientId, numberOfInstallments >= 3)
end

// Level 3: Maximum period check
query withinMaximumPeriod(Long $clientId)
    LoanRequest(clientId == $clientId, numberOfInstallments <= 360)
end

// ========================================================================
// Level 2: Employment stability
// ========================================================================
query hasStableEmployment(Long $clientId)
    isNotUnemployed($clientId; ) and
    employmentCoversFullTerm($clientId; )
end

// Level 3: Client must be employed
query isNotUnemployed(Long $clientId)
    $req: LoanRequest(clientId == $clientId, employmentStatus != null)
    eval(!$req.getEmploymentStatus().toUpperCase().equals("UNEMPLOYED"))
end

// Level 3: Contract must cover the full loan repayment period
query employmentCoversFullTerm(Long $clientId)
    $req: LoanRequest(clientId == $clientId, $inst: numberOfInstallments)
    (isIndefinite($req; ) or fixedTermCoversPeriod($req, $inst; ))
end

// Level 4: Indefinite employment always covers the full term
query isIndefinite(LoanRequest $req)
    eval(!$req.getEmploymentStatus().toUpperCase().equals("FIXED_TERM"))
end

// Level 4: Fixed-term contract must extend beyond the loan period
query fixedTermCoversPeriod(LoanRequest $req, int $inst)
    eval($req.getEmploymentStatus().toUpperCase().equals("FIXED_TERM") &&
         $req.getContractEndDate() != null &&
         $req.getContractEndDate().isAfter(LocalDate.now().plusMonths((long) $inst)))
end

// ========================================================================
// Level 2: Income sufficiency
// ========================================================================
query hasSufficientIncome(Long $clientId)
    paymentIsAffordable($clientId; ) and
    totalDebtIsAcceptable($clientId; )
end

// Level 3: Monthly payment must not exceed 70% of income
query paymentIsAffordable(Long $clientId)
    $req: LoanRequest(clientId == $clientId, $amount: loanAmount, $inst: numberOfInstallments)
    $profile: ClientFinancialProfile(clientId == $clientId, $income: monthlyIncome)
    eval($income > 0 && computeMonthlyPayment($amount, $inst) <= $income * 0.7)
end

// Level 3: Total debt (new + existing) must not exceed 50% of income
query totalDebtIsAcceptable(Long $clientId)
    $req: LoanRequest(clientId == $clientId, $amount: loanAmount, $inst: numberOfInstallments)
    $profile: ClientFinancialProfile(clientId == $clientId, $income: monthlyIncome, $existingPayments: totalExistingLoanPayments)
    eval($income > 0 && (computeMonthlyPayment($amount, $inst) + $existingPayments) / $income <= 0.5)
end

// ========================================================================
// Level 2: Risk assessment
// ========================================================================
query hasAcceptableRisk(Long $clientId)
    $req: LoanRequest(clientId == $clientId)
    $profile: ClientFinancialProfile(clientId == $clientId)
    eval(computeRiskScore($req, $profile) < 50.0)
end

// ========================================================================
// FORWARD-CHAINING RULES — triggered by backward chaining results
// These rules exist only to capture the backward chaining conclusions
// into a result fact (LoanAssessment) that the Java code can read.
// ========================================================================

rule "Initialize Loan Assessment"
    salience 100
    when
        $req: LoanRequest($clientId: clientId, $amount: loanAmount, $inst: numberOfInstallments)
        $profile: ClientFinancialProfile(clientId == $clientId)
        not LoanAssessment(clientId == $clientId)
    then
        LoanAssessment assessment = new LoanAssessment($clientId);
        double payment = computeMonthlyPayment($amount, $inst);
        double score = computeRiskScore($req, $profile);
        String level = computeRiskLevel(score);
        double dti = $profile.getMonthlyIncome() > 0
            ? (payment + $profile.getTotalExistingLoanPayments()) / $profile.getMonthlyIncome()
            : 1.0;
        assessment.setMonthlyPayment(payment);
        assessment.setRiskScore(score);
        assessment.setRiskLevel(level);
        assessment.setDebtToIncomeRatio(Math.round(dti * 10000.0) / 10000.0);
        insert(assessment);
end

rule "Loan Approved"
    no-loop true
    lock-on-active true
    when
        $assessment: LoanAssessment(clientId == $clientId,
            reasons excludes "Loan approved: all criteria satisfied via backward chaining")
        isLoanApproved($clientId; )
    then
        modify($assessment) {
            addReason("Loan approved: all criteria satisfied via backward chaining")
        }
end

rule "Reject Invalid Loan Period"
    no-loop true
    lock-on-active true
    when
        $assessment: LoanAssessment(clientId == $clientId,
            reasons excludes "Loan period must be between 3 and 360 months")
        not hasValidLoanPeriod($clientId; )
    then
        modify($assessment) {
            setApproved(false),
            addReason("Loan period must be between 3 and 360 months")
        }
end

rule "Reject Unstable Employment"
    no-loop true
    lock-on-active true
    when
        $assessment: LoanAssessment(clientId == $clientId,
            reasons excludes "Client does not have stable employment for the loan duration")
        hasValidLoanPeriod($clientId; )
        not hasStableEmployment($clientId; )
    then
        modify($assessment) {
            setApproved(false),
            addReason("Client does not have stable employment for the loan duration")
        }
end

rule "Reject Insufficient Income"
    no-loop true
    lock-on-active true
    when
        $assessment: LoanAssessment(clientId == $clientId,
            reasons excludes "Insufficient income to cover loan payments")
        hasValidLoanPeriod($clientId; )
        hasStableEmployment($clientId; )
        not hasSufficientIncome($clientId; )
    then
        modify($assessment) {
            setApproved(false),
            addReason("Insufficient income to cover loan payments")
        }
end

rule "Reject Unacceptable Risk"
    no-loop true
    lock-on-active true
    when
        $assessment: LoanAssessment(clientId == $clientId,
            reasons excludes "Overall risk score is too high for loan approval")
        hasValidLoanPeriod($clientId; )
        hasStableEmployment($clientId; )
        hasSufficientIncome($clientId; )
        not hasAcceptableRisk($clientId; )
    then
        modify($assessment) {
            setApproved(false),
            addReason("Overall risk score is too high for loan approval")
        }
end
